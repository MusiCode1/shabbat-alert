{
  "name": "shabbat-alert",
  "private": true,
  "workspaces": ["apps/web", "worker"],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "build:worker": "cd worker && bunx wrangler deploy --dry-run",
    "check": "bun run --cwd apps/web check",
    "deploy:worker": "cd worker && bunx wrangler deploy",
    "deploy:web": "bun run --cwd apps/web build && bunx wrangler pages deploy apps/web/.svelte-kit/cloudflare --project-name shabbat-alert-web"
  }
}
